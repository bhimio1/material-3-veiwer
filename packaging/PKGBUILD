# Maintainer: bhimio1
pkgname=material-3-viewer-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Material 3 image and video viewer with quick, non-destructive edits"
arch=('x86_64' 'aarch64')
url="https://github.com/bhimio1/material-3-veiwer"
license=('MIT')
depends=('libxkbcommon' 'wayland' 'libglvnd')
makedepends=('cargo' 'git')
optdepends=(
  'mpv: video playback (through libmpv)'
  'ffmpegthumbnailer: video thumbnails (ffmpeg works too)'
  'ffmpeg: video thumbnails'
  'wl-clipboard: copy images on Wayland'
  'xclip: copy images on X11'
  'xdg-desktop-portal: the Open and Save as dialogs'
  'swww: set wallpapers without end4-pC'
  'hyprpaper: set wallpapers without end4-pC'
  'material-3-file-manager: Show in Files'
)
provides=('material-3-viewer')
conflicts=('material-3-viewer' 'material-3-viewer-bin')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/m3-viewer "$pkgdir/usr/bin/m3-viewer"
  install -Dm644 packaging/material_3_viewer.desktop "$pkgdir/usr/share/applications/material_3_viewer.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/fonts/LICENSE-Inter.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Inter.txt"
}
