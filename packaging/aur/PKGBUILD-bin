# Maintainer: bhimio1
# Template: the release workflow fills in @PKGVER@ and @SHA256@ and publishes
# this to the AUR as material-3-viewer-bin.
pkgname=material-3-viewer-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc="Material 3 image and video viewer with quick, non-destructive edits"
arch=('x86_64')
url="https://github.com/bhimio1/material-3-veiwer"
license=('MIT')
depends=('libxkbcommon' 'wayland' 'libglvnd')
optdepends=(
  'mpv: video playback (through libmpv)'
  'ffmpegthumbnailer: video thumbnails (ffmpeg works too)'
  'ffmpeg: video thumbnails'
  'wl-clipboard: copy images on Wayland'
  'xclip: copy images on X11'
  'xdg-desktop-portal: the Open and Save as dialogs'
  'swww: set wallpapers without end4-pC'
  'hyprpaper: set wallpapers without end4-pC'
  'material-3-file-manager: Show in Files'
)
provides=('material-3-viewer')
conflicts=('material-3-viewer' 'material-3-viewer-git')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/m3-viewer-x86_64-linux.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "m3-viewer-x86_64-linux"
  install -Dm755 m3-viewer "$pkgdir/usr/bin/m3-viewer"
  install -Dm644 material_3_viewer.desktop "$pkgdir/usr/share/applications/material_3_viewer.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-Inter.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Inter.txt"
}
